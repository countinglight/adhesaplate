# The review deployment's noindex rule is not in this file: it is appended to
# the built copy by scripts/mark-review-headers.js, which decides from the
# routes in wrangler.site.jsonc.

# Astro content-hashes everything under /_astro/.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

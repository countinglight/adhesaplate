---
import Icon from "./Icon.astro";
import { quoteHref, site } from "../site.config";

interface Props {
  title?: string;
  text?: string;
}
const {
  title = "Know what you need?",
  text = "Tell us about the surface, the environment and the quantity, and we will help you build the right label.",
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={quoteHref}>Get a free quote</a>
      <a class="btn btn--ghost" href={site.phone.href}>
        <Icon name="phone" size={18} />
        Call {site.phone.display}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    color: #fff;
    background:
      radial-gradient(40rem 20rem at 10% 120%, rgb(34 211 238 / 0.4), transparent 60%),
      var(--gradient-deep);
  }
  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.75rem;
    padding-block: clamp(2.75rem, 6vw, 4.25rem);
  }
  .cta-band__copy {
    display: grid;
    gap: 0.6rem;
    max-width: 36rem;
  }
  .cta-band h2 {
    color: #fff;
  }
  .cta-band p {
    color: rgb(255 255 255 / 0.85);
  }
</style>

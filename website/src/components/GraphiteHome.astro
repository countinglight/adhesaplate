---
// Alternate visual composition. Marketing copy and links come from the existing home page.
import { Image } from "astro:assets";
import heroPhoto from "../assets/img/graphite-hero.jpg";
import { apart, understand, stats, featured } from "../homeContent";
import { quoteHref, site } from "../site.config";
---

<section class="g-hero">
  <Image class="g-hero__photo" src={heroPhoto} alt="Forested Pacific Northwest hills and water" widths={[960, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
  <div class="container g-hero__inner">
    <div class="g-hero__copy">
      <p class="g-kicker">Welcome to Adhesa Plate</p>
      <h1>We make amazing labels</h1>
      <p class="g-hero__lead">Custom labels, product markings, graphic overlays and membrane switches, UL 969 tested and approved and built in the Seattle area since {site.founded}.</p>
      <div class="g-actions">
        <a class="g-button" href={quoteHref}>Get a free quote</a>
        <a class="g-button g-button--outline" href="/products/">See all our products</a>
      </div>
    </div>
    <div class="g-glance">
      <h2>What sets us apart</h2>
      <dl>{stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}</dl>
    </div>
  </div>
</section>

<div class="g-proof" aria-label="Certifications and standards">
  <div class="container"><span>UL 969 approved</span><span>ISO 9001 based quality system</span><span>RoHS compliant materials</span></div>
</div>

<section class="g-section" id="graphite-products">
  <div class="container">
    <p class="g-kicker">Our products &amp; services</p>
    <h2>Find the label for your application</h2>
    <ul class="g-products">
      {featured.map((product) => <li><a href={product.path}><h3>{product.title}</h3><p>{product.summary}</p><span>Learn more <span aria-hidden="true">→</span></span></a></li>)}
    </ul>
  </div>
</section>

<section class="g-section g-section--industries">
  <div class="container">
    <p class="g-kicker">What sets us apart</p>
    <h2>Labels built for demanding equipment</h2>
    <ul class="g-industries">
      {apart.map((item) => <li><div><h3>{item.title}</h3><p>{item.text}</p></div></li>)}
    </ul>
  </div>
</section>

<section class="g-story">
  <div class="container g-story__inner">
    <div>
      <p class="g-kicker">About us</p>
      <h2>How we operate</h2>
      <p class="g-story__intro">We understand that every industry is unique, and we always give our best for each client we work with. Which is why we take so much time to understand:</p>
    </div>
    <div class="g-story__copy">
      {understand.map((step, index) => <div class="g-story__step"><strong>{index + 1}. {step.title}</strong><p>{step.text}</p></div>)}
      <a href="/about-us/">Our history <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="g-quote">
  <div class="container g-quote__inner">
    <div><h2>Know what you need?</h2><p>Tell us about the surface, the environment and the quantity, and we will help you build the right label.</p></div>
    <div class="g-actions"><a class="g-quote__phone" href={site.phone.href}>{site.phone.display}</a><a class="g-button" href={quoteHref}>Get a free quote</a></div>
  </div>
</section>

<style>
  .g-hero { position: relative; overflow: hidden; background: #1c1f23; color: #fff; }
  .g-hero__photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 58%; opacity: .23; }
  .g-hero::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(28 31 35 / .72), rgb(28 31 35 / .28)); pointer-events: none; }
  .g-hero__inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); align-items: center; gap: clamp(2rem, 6vw, 4.5rem); padding-block: 5rem 5.5rem; }
  .g-kicker { color: #c2410c; font: 500 .75rem/1.4 "IBM Plex Mono", ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .g-hero .g-kicker { color: #ffb38a; display: flex; gap: .75rem; align-items: center; }
  .g-hero h1 { margin: 1.25rem 0 1.4rem; color: #fff; font-size: clamp(2.5rem, 4.1vw, 3.5rem); line-height: 1.08; font-weight: 600; }
  .g-hero__lead { max-width: 34rem; margin-bottom: 2rem; color: #d7d9db; font-size: 1.18rem; }
  .g-actions { display: flex; flex-wrap: wrap; gap: .85rem; align-items: center; }
  .g-button { display: inline-flex; min-height: 3.1rem; align-items: center; justify-content: center; padding: .8rem 1.6rem; border: 1px solid #c2410c; border-radius: 8px; background: #c2410c; color: #fff; font-weight: 600; text-decoration: none; }
  .g-button:hover { background: #a6350b; color: #fff; }
  .g-button--outline { border-color: #8f979f; background: transparent; }
  .g-button--outline:hover { border-color: #fff; background: rgb(255 255 255 / .12); }
  .g-glance { padding: 1.75rem 2rem; background: rgb(28 31 35 / .7); border: 1px solid rgb(255 255 255 / .18); backdrop-filter: blur(8px); }
  .g-glance h2 { margin-bottom: .6rem; color: #ffb38a; font: 500 .75rem/1.4 "IBM Plex Mono", ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .g-glance dl { margin: 0; }
  .g-glance dl div { display: grid; grid-template-columns: 7.8rem 1fr; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid #4a5056; font-size: .88rem; }
  .g-glance dl div:last-child { border-bottom: 0; }
  .g-glance dt { color: #ffb38a; font-weight: 600; }
  .g-glance dd { margin: 0; color: #f4f4f2; }
  .g-proof { background: #fff; border-bottom: 1px solid #dad9d4; }
  .g-proof .container { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .8rem 2rem; padding-block: 1.25rem; color: #4a4f55; font: 500 .72rem/1.5 "IBM Plex Mono", ui-monospace, monospace; letter-spacing: .05em; text-transform: uppercase; }
  .g-section { padding-block: 5.5rem 2rem; }
  .g-section h2, .g-story h2, .g-quote h2 { margin: .65rem 0 2.2rem; font-size: clamp(2rem, 3vw, 2.75rem); font-weight: 600; }
  .g-products { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; padding: 1px; background: #dad9d4; }
  .g-products li { background: #fff; }
  .g-products a { display: flex; flex-direction: column; min-height: 13.5rem; height: 100%; padding: 1.6rem; color: inherit; text-decoration: none; }
  .g-products a:hover { background: #fff8f3; }
  .g-products h3 { margin-bottom: .55rem; font-size: 1.2rem; }
  .g-products p { margin-bottom: 1.1rem; color: #4a4f55; font-size: .93rem; }
  .g-products a > span { margin-top: auto; color: #c2410c; font-weight: 600; font-size: .88rem; }
  .g-section--industries { padding-block: 4rem 4.5rem; }
  .g-industries { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid #dad9d4; border-bottom: 1px solid #dad9d4; }
  .g-industries li:not(:last-child) { border-right: 1px solid #dad9d4; }
  .g-industries li > div { height: 100%; padding: 1.5rem; }

  .g-industries h3 { font-size: 1.15rem; }
  .g-industries p { margin-top: .3rem; color: #4a4f55; font-size: .92rem; }
  .g-story { background: #fff; border-block: 1px solid #dad9d4; }
  .g-story__inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 4.5rem; padding-block: 5.5rem; }
  .g-story h2 { max-width: 13ch; margin-bottom: 0; }
  .g-story__intro { margin-top: 1rem; max-width: 35rem; color: #4a4f55; font-size: 1.08rem; }
  .g-story__step strong { color: #1c1f23; }
  .g-story__step { padding-bottom: .75rem; border-bottom: 1px solid #dad9d4; }
  .g-story__copy { display: grid; align-content: center; gap: .9rem; color: #4a4f55; font-size: 1.08rem; }
  .g-story__copy a { margin-top: .5rem; font-weight: 600; text-decoration: none; }
  .g-quote { background: #f8eee7; border-top: 1px solid #dad9d4; }
  .g-quote__inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-block: 4.5rem; }
  .g-quote h2 { max-width: 16ch; margin-bottom: .8rem; }
  .g-quote p { max-width: 42rem; color: #4a4f55; font-size: 1.1rem; }
  .g-quote__phone { color: #1c1f23; font-size: 1.1rem; font-weight: 600; white-space: nowrap; text-decoration: none; }
  @media (max-width: 950px) { .g-hero__inner, .g-story__inner { grid-template-columns: 1fr; gap: 2rem; } .g-products { grid-template-columns: repeat(2, minmax(0, 1fr)); } .g-industries { grid-template-columns: repeat(2, minmax(0, 1fr)); } .g-industries li:nth-child(2) { border-right: 0; } .g-industries li:nth-child(-n+2) { border-bottom: 1px solid #dad9d4; } .g-quote__inner { flex-wrap: wrap; } }
  @media (max-width: 580px) { .g-hero__inner { padding-block: 3.5rem; } .g-glance { padding: 1.2rem; } .g-glance dl div { grid-template-columns: 6rem 1fr; gap: .65rem; } .g-products, .g-industries { grid-template-columns: 1fr; } .g-industries li { border-right: 0 !important; border-bottom: 1px solid #dad9d4; } .g-industries li:last-child { border-bottom: 0; } .g-section { padding-block: 3.5rem 1.5rem; } .g-story__inner { padding-block: 3.5rem; } .g-quote__inner { padding-block: 3.5rem; } }
</style>

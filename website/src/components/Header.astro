---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { nav, quoteHref, site } from "../site.config";

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.path} aria-current={current === item.path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={site.phone.href}>
        <Icon name="phone" size={18} />
        <span>{site.phone.display}</span>
      </a>
      <a class="btn btn--primary site-header__quote" href={quoteHref}>Get a quote</a>

    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(8 24 60 / 0.9);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: var(--header-h);
    /* Navigation needs more room than the reading column used by page content. */
    width: calc(100% - 2 * var(--gutter));
    max-width: none;
  }
  .site-header__logo {
    text-decoration: none;
    flex: none;
  }
  .site-nav ul {
    display: flex;
    gap: 0.15rem;
  }
  .site-nav a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    color: var(--nav-link-color, rgb(255 255 255 / 0.82));
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--nav-hover-color, #fff);
    background: var(--nav-hover-bg, rgb(255 255 255 / 0.12));
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex: none;
  }
  .site-header__phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    color: var(--header-text, #fff);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__quote {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.94rem;
    white-space: nowrap;
  }

  @media (min-width: 1800px) {
    .site-header__phone {
      display: inline-flex;
    }
  }
  @media (max-width: 1250px) {
    .site-header__bar {
      flex-wrap: wrap;
      gap: 0.15rem 1rem;
      padding-block: 0.5rem;
    }
    .site-nav {
      order: 3;
      flex: 0 0 100%;
    }
    .site-nav ul {
      justify-content: center;
      flex-wrap: wrap;
    }
  }
  @media (max-width: 520px) {
    .site-header__quote {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .site-header__bar { gap: .25rem; }
    .site-nav { overflow-x: auto; scrollbar-width: thin; }
    .site-nav ul { justify-content: flex-start; flex-wrap: nowrap; width: max-content; }
    .site-nav a { white-space: nowrap; }
  }
</style>

---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import { nav, quoteHref, site } from "../site.config";

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href="/" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.path} aria-current={current === item.path ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <ThemeSwitcher />
      <a class="site-header__phone" href={site.phone.href}>
        <Icon name="phone" size={18} />
        <span>{site.phone.display}</span>
      </a>
      <a class="btn btn--primary site-header__quote" href={quoteHref}>Get a quote</a>

      <!-- Mobile menu: a native disclosure, so it works without JavaScript. -->
      <details class="mobile-menu">
        <summary aria-label="Menu">
          <Icon name="menu" />
        </summary>
        <nav class="mobile-menu__panel" aria-label="Mobile">
          <ThemeSwitcher />
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.path} aria-current={current === item.path ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--primary" href={quoteHref}>Get a quote</a>
          <a class="btn btn--ghost" href={site.phone.href}>
            <Icon name="phone" size={18} />
            {site.phone.display}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(8 24 60 / 0.9);
    backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--header-h);
  }
  .site-header__logo {
    text-decoration: none;
    margin-right: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 0.15rem;
  }
  .site-nav a,
  .mobile-menu__panel li a {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    color: var(--nav-link-color, rgb(255 255 255 / 0.82));
    font-size: 0.94rem;
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--nav-hover-color, #fff);
    background: var(--nav-hover-bg, rgb(255 255 255 / 0.12));
  }
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .site-header__phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    color: var(--header-text, #fff);
    font-weight: 700;
    font-size: 0.94rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-header__quote {
    min-height: 2.6rem;
    padding: 0.5rem 1.1rem;
    font-size: 0.94rem;
    white-space: nowrap;
  }

  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 12px;
    color: var(--header-text, #fff);
    background: rgb(255 255 255 / 0.1);
    cursor: pointer;
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mobile-menu__panel {
    --theme-label-display-mobile: inline;
    position: absolute;
    inset: var(--header-h) 0 auto 0;
    display: grid;
    gap: 0.75rem;
    padding: 1rem var(--gutter) 1.5rem;
    background: var(--ink-900);
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: var(--shadow-lg);
    max-height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }
  .mobile-menu__panel ul {
    display: grid;
  }
  .mobile-menu__panel li a {
    padding: 0.85rem 0.5rem;
    border-radius: 0;
    font-size: 1.05rem;
    border-bottom: 1px solid var(--nav-line-color, rgb(255 255 255 / 0.08));
  }
  .mobile-menu__panel li a[aria-current="page"] {
    color: var(--nav-current-color, var(--cyan-300));
  }

  @media (min-width: 1600px) {
    .site-header__phone {
      display: inline-flex;
    }
  }
  @media (max-width: 1500px) {
    .site-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .site-header__quote {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .site-header__bar { gap: .5rem; }
    .site-header__actions { gap: .5rem; }
    .site-header__actions > :global(.theme-switcher) { display: none; }
    .mobile-menu__panel > :global(.theme-switcher) { justify-content: space-between; padding: .4rem .5rem; }
    .mobile-menu__panel > :global(.theme-switcher) span { display: inline; }
  }
</style>

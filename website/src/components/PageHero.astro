---
// Title band for inner pages. Also emits the page's breadcrumb trail, both
// visibly and as structured data.
import { breadcrumbs } from "../lib/structured-data";

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
}
const { title, lead, eyebrow } = Astro.props;
const trail = [
  { name: "Home", path: "/" },
  { name: title, path: Astro.url.pathname },
];
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <nav class="page-hero__crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    {eyebrow && eyebrow.toLowerCase() !== title.toLowerCase() && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs(trail))} />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    color: #fff;
    background:
      radial-gradient(60rem 26rem at 88% -20%, rgb(34 211 238 / 0.45), transparent 60%),
      var(--gradient-deep);
  }
  .page-hero__inner {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2.75rem, 7vw, 5rem);
    max-width: 1180px;
  }
  .page-hero h1 {
    color: #fff;
    font-size: clamp(2.1rem, 5vw, 3.25rem);
    max-width: 20ch;
  }
  .page-hero .eyebrow {
    color: var(--cyan-300);
  }
  .page-hero .lead {
    color: rgb(255 255 255 / 0.85);
    max-width: 44rem;
  }
  .page-hero__crumbs {
    display: flex;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: rgb(255 255 255 / 0.7);
  }
  .page-hero__crumbs a {
    color: rgb(255 255 255 / 0.85);
  }
</style>

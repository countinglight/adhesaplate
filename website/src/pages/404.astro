---
import Base from "../layouts/Base.astro";
import { nav } from "../site.config";
---

<Base title="Page not found" noindex>
  <section class="section">
    <div class="container prose">
      <p class="eyebrow">404</p>
      <h1>We could not find that page</h1>
      <p class="lead">The address may have changed. One of these should get you where you are going:</p>
      <ul class="chip-list">
        <li><a class="chip" href="/">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a class="chip" href={item.path}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .chip-list {
    list-style: none;
    padding: 0;
    display: flex;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
  }
</style>

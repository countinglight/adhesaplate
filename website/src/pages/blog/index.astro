---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";

const posts = (await getCollection("pages", ({ data }) => data.section === "blog"))
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---

<Base
  title="Blog"
  description="News, materials guidance, and ideas for custom industrial labels and graphic overlays from Adhesa Plate."
>
  <PageHero
    eyebrow="Ideas & updates"
    title="From the Adhesa Plate blog"
    lead="Explore our articles on custom labels, materials, manufacturing and product marking."
  />
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Articles</p>
        <h2>Latest from the team</h2>
      </div>
      <ul class="posts">
        {posts.map((post) => (
          <li class="card post">
            {post.data.image && (
              <div class="post__image">
                <Image
                  src={post.data.image}
                  alt={post.data.imageAlt ?? ""}
                  widths={[320, 520, 760]}
                  sizes="(min-width: 900px) 32vw, (min-width: 620px) 48vw, 92vw"
                  loading="lazy"
                />
              </div>
            )}
            {post.data.date && (
              <p class="post__date">
                {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            )}
            <h3><a class="card__title-link" href={post.data.path}>{post.data.title}</a></h3>
            <p>{post.data.description}</p>
            <a class="post__read" href={post.data.path}>Read article <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .posts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }
  .post { align-content: start; }
  .post__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: calc(-1 * clamp(1.25rem, 2.4vw, 1.75rem));
    margin-bottom: 0.25rem;
    background: var(--surface-soft);
    border-radius: var(--radius) var(--radius) 0 0;
  }
  .post__image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .post__date { color: var(--ink-500); font-size: 0.85rem; font-weight: 700; }
  .post h3 { font-size: 1.2rem; }
  .post__read { margin-top: auto; font-weight: 700; text-decoration: none; }
</style>
